<?xml version="1.0"?>
<!-- Uppix: JWM ayarları (startx JWM'yi bununla başlatır). Yazı tipi X sunucusunun gömülü
     "fixed" yazı tipidir (Xft yok). Menü masaüstüne sol tıklayınca ya da tepsideki
     "Uppix" düğmesiyle açılır. -->
<JWM>
    <RootMenu onroot="1" label="Uppix">
        <Program label="Test penceresi (xdeneme)">/usr/bin/xdeneme</Program>
        <Separator/>
        <Restart label="JWM'yi yeniden başlat"/>
        <Exit label="Oturumu kapat" confirm="false"/>
    </RootMenu>

    <Tray x="0" y="-1" height="24" autohide="off">
        <TrayButton label="Uppix">root:1</TrayButton>
        <Spacer width="4"/>
        <TaskList maxwidth="200"/>
    </Tray>

    <WindowStyle>
        <Font>fixed</Font>
        <Width>3</Width>
        <Height>18</Height>
        <Foreground>#D0D0D0</Foreground>
        <Background>#404040</Background>
        <Outline>#000000</Outline>
        <Active>
            <Foreground>#FFFFFF</Foreground>
            <Background>#2A5D8A</Background>
            <Outline>#000000</Outline>
        </Active>
    </WindowStyle>

    <TrayStyle>
        <Font>fixed</Font>
        <Background>#1E3A5F</Background>
        <Foreground>#FFFFFF</Foreground>
    </TrayStyle>

    <TaskListStyle>
        <Font>fixed</Font>
        <Foreground>#FFFFFF</Foreground>
        <Background>#2B4F7A</Background>
        <Active>
            <Foreground>#FFFFFF</Foreground>
            <Background>#3A6EA5</Background>
        </Active>
    </TaskListStyle>

    <MenuStyle>
        <Font>fixed</Font>
        <Foreground>#000000</Foreground>
        <Background>#E8E8E8</Background>
        <Active>
            <Foreground>#FFFFFF</Foreground>
            <Background>#2A5D8A</Background>
        </Active>
    </MenuStyle>

    <Desktops width="1" height="1">
        <Background type="solid">#204060</Background>
    </Desktops>

    <!-- JWM açılışını (tepsi, arka plan) bitirince çalışır; startx'in konsoluna yazar. -->
    <StartupCommand>echo "jwm: masaüstü hazır"</StartupCommand>

    <FocusModel>click</FocusModel>
    <SnapMode distance="10">border</SnapMode>
    <MoveMode>outline</MoveMode>
    <ResizeMode>outline</ResizeMode>

    <Key mask="A" key="Tab">nextstacked</Key>
    <Key mask="A" key="F4">close</Key>
    <Key mask="A" key="F2">root:1</Key>
</JWM>
