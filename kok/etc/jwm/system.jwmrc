<?xml version="1.0"?>
<!-- Uppix: JWM 2.4 ayarları (startx JWM'yi bununla başlatır; kişisel ayarlar ~/.jwmrc'ye).
     Yazı tipi X sunucusunun gömülü "fixed" yazı tipidir (Xft yok). Bu yazı tipi ISO 8859-1'dir
     ve JWM metni dönüştürmeden çizer: ş, ğ, ı gibi harfler bozuk görünür, bu yüzden aşağıdaki
     etiketler ASCII'dir. Menü masaüstüne sol ya da sağ tıklayınca, tepsideki "Uppix"
     düğmesiyle ya da Alt-F1 ile açılır. -->
<JWM>
    <RootMenu onroot="13" label="Uppix">
        <Program label="Test penceresi (xdeneme)">/usr/bin/xdeneme</Program>
        <Separator/>
        <Desktops label="Masalar"/>
        <Separator/>
        <Restart label="JWM'yi yenile"/>
        <Exit label="Oturumu kapat" confirm="false"/>
    </RootMenu>

    <!-- Alt şerit: menü düğmesi, iki masanın küçük görünümü, pencere listesi, saat (UTC). -->
    <Tray x="0" y="-1" height="24" autohide="off">
        <TrayButton label="Uppix">root:1</TrayButton>
        <Spacer width="4"/>
        <Pager labeled="true"/>
        <Spacer width="4"/>
        <TaskList maxwidth="200"/>
        <Clock format="%H:%M"/>
    </Tray>

    <WindowStyle>
        <Font>fixed</Font>
        <Width>3</Width>
        <Height>18</Height>
        <Corner>0</Corner>
        <Foreground>#D0D0D0</Foreground>
        <Background>#404040</Background>
        <Outline>#000000</Outline>
        <Active>
            <Foreground>#FFFFFF</Foreground>
            <Background>#2A5D8A</Background>
            <Outline>#000000</Outline>
        </Active>
    </WindowStyle>

    <TrayStyle>
        <Font>fixed</Font>
        <Background>#1E3A5F</Background>
        <Foreground>#FFFFFF</Foreground>
    </TrayStyle>

    <TaskListStyle list="desktop" group="false">
        <Font>fixed</Font>
        <Foreground>#FFFFFF</Foreground>
        <Background>#2B4F7A</Background>
        <Active>
            <Foreground>#FFFFFF</Foreground>
            <Background>#3A6EA5</Background>
        </Active>
    </TaskListStyle>

    <PagerStyle>
        <Font>fixed</Font>
        <Outline>#000000</Outline>
        <Foreground>#2B4F7A</Foreground>
        <Background>#1E3A5F</Background>
        <Text>#FFFFFF</Text>
        <Active>
            <Foreground>#3A6EA5</Foreground>
            <Background>#2A5D8A</Background>
        </Active>
    </PagerStyle>

    <ClockStyle>
        <Font>fixed</Font>
        <Foreground>#FFFFFF</Foreground>
        <Background>#1E3A5F</Background>
    </ClockStyle>

    <MenuStyle>
        <Font>fixed</Font>
        <Foreground>#000000</Foreground>
        <Background>#E8E8E8</Background>
        <Outline>#404040</Outline>
        <Active>
            <Foreground>#FFFFFF</Foreground>
            <Background>#2A5D8A</Background>
        </Active>
    </MenuStyle>

    <PopupStyle>
        <Font>fixed</Font>
        <Foreground>#000000</Foreground>
        <Background>#FFFFE0</Background>
        <Outline>#000000</Outline>
    </PopupStyle>

    <!-- İki masa; ikisinin de arka planı aynı düz renk. -->
    <Desktops width="2" height="1">
        <Desktop name="1"/>
        <Desktop name="2"/>
        <Background type="solid">#204060</Background>
    </Desktops>

    <!-- JWM açılışını (tepsi, arka plan) bitirince çalışır; startx'in konsoluna yazar. -->
    <StartupCommand>echo "jwm: masaüstü hazır"</StartupCommand>

    <FocusModel>click</FocusModel>
    <SnapMode distance="10">border</SnapMode>
    <!-- Çerçeve tamponunda yazılımla çizildiğinden taşıma/boyutlandırma çerçeveyle -->
    <MoveMode>outline</MoveMode>
    <ResizeMode>outline</ResizeMode>
    <DoubleClickSpeed>400</DoubleClickSpeed>
    <DoubleClickDelta>2</DoubleClickDelta>

    <!-- Menülerde ve pencere değiştirmede gezinme (yalnızca bunlar açıkken alınır) -->
    <Key key="Up">up</Key>
    <Key key="Down">down</Key>
    <Key key="Right">right</Key>
    <Key key="Left">left</Key>
    <Key key="Return">select</Key>
    <Key key="Escape">escape</Key>

    <Key mask="A" key="Tab">nextstacked</Key>
    <Key mask="AS" key="Tab">prevstacked</Key>
    <Key mask="A" key="F1">root:1</Key>
    <Key mask="A" key="F2">window</Key>
    <Key mask="A" key="F4">close</Key>
    <Key mask="A" key="F9">minimize</Key>
    <Key mask="A" key="F10">maximize</Key>
    <Key mask="A" key="#">desktop#</Key>
    <Key mask="CA" key="Right">rdesktop</Key>
    <Key mask="CA" key="Left">ldesktop</Key>

    <!-- JWM 2.4'te fare bağlamalarının varsayılanı yoktur: bunlar olmadan pencereler
         başlıktan taşınamaz, köşe düğmeleri çalışmaz. -->
    <Mouse context="root" button="4">ldesktop</Mouse>
    <Mouse context="root" button="5">rdesktop</Mouse>

    <Mouse context="title" button="1">move</Mouse>
    <Mouse context="title" button="2">move</Mouse>
    <Mouse context="title" button="3">window</Mouse>
    <Mouse context="title" button="4">shade</Mouse>
    <Mouse context="title" button="5">shade</Mouse>

    <Mouse context="icon" button="1">window</Mouse>
    <Mouse context="icon" button="3">window</Mouse>

    <Mouse context="border" button="1">resize</Mouse>
    <Mouse context="border" button="2">move</Mouse>
    <Mouse context="border" button="3">window</Mouse>

    <Mouse context="close" button="-1">close</Mouse>
    <Mouse context="close" button="-3">close</Mouse>

    <Mouse context="maximize" button="-1">maximize</Mouse>
    <Mouse context="maximize" button="-2">maxv</Mouse>
    <Mouse context="maximize" button="-3">maxh</Mouse>

    <Mouse context="minimize" button="-1">minimize</Mouse>
    <Mouse context="minimize" button="-3">shade</Mouse>
</JWM>
