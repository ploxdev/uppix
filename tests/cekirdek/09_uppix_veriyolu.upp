// Çekirdek: Uppix aygıt ağacı (FreeBSD newbus tasarımı) QEMU i440fx'te.
// - pciconf -l ana köprüyü (8086:1237) ve PIIX3 IDE'yi (8086:7010) atapci0 olarak gösterir.
// - devinfo ağacı nexus0 → pci0 → atapci0 → ata0/ata1; -v kimlik ve konumu gösterir.
// - Diskler ata sürücüsünden disk kaydına girer; blok katmanı eskisi gibi okur ve yazar.
// @gerek: mkfs.ext4 e2fsck debugfs sfdisk mkfs.fat fsck.fat mcopy mtype
// @hazirla: rm -rf tests/_cikti/disk09 && sh disk_yap.sh tests/_cikti/disk09
// @bayrak: --disk tests/_cikti/disk09/uppix-kok.img --disk tests/_cikti/disk09/usb-fat32.img
// @girdi: pciconf -l
// @girdi: pciconf -lv | grep subclass | sort -u | tr '\n' ','
// @girdi: pciconf -lb
// @girdi: devinfo
// @girdi: devinfo -v | grep atapci0
// @girdi: pciconf -x
// @girdi: lsblk
// @girdi: cat /proc/partitions
// @girdi: echo "veri yolu yazdı" > /root/vy.txt && cat /root/vy.txt
// @girdi: cat "/mnt/sdb1/Türkçe uzun dosya adı.txt"
// @girdi: dmesg | grep sda:
// @girdi: poweroff
// @icerir: hostb0@pci0:0:0:0:	class=0x060000 rev=0x02 hdr=0x00 vendor=0x8086 device=0x1237
// @icerir: isab0@pci0:0:1:0:	class=0x060100 rev=0x00 hdr=0x00 vendor=0x8086 device=0x7000
// @icerir: atapci0@pci0:0:1:1:	class=0x010180 rev=0x00 hdr=0x00 vendor=0x8086 device=0x7010
// @icerir: none0@pci0:0:1:3:
// @icerir: subclass   = ATA,
// @icerir: subclass   = HOST-PCI,
// @icerir: = tür G/Ç portu, aralık 32, taban 0xc0
// @icerir: nexus0
// @icerir:   pci0
// @icerir:     hostb0
// @icerir:     atapci0
// @icerir:       ata0
// @icerir:       ata1
// @icerir: atapci0 pnpinfo vendor=0x8086 device=0x7010 subvendor=0x1af4 subdevice=0x1100 class=0x010180 at slot=1 function=1 dbsf=pci0:0:1:1
// @icerir: pciconf: geçersiz seçenek: -x
// @icerir: kullanım: pciconf -l [-bv]
// @icerir: sda       64M disk  ext4   uppix-kok        /
// @icerir: └─sdb1    63M part  vfat   UPPIXUSB         /mnt/sdb1
// @icerir:    8    16     65536 sdb
// @icerir: veri yolu yazdı
// @icerir: Uzun ve Türkçe bir dosya adı: şğüöçı ŞĞÜÖÇİ
// @icerir: atapci0: <Intel PIIX3 WDMA2 denetleyicisi> pci0 üzerinde
// @icerir: sda: <QEMU HARDDISK> 64M, ata0 üzerinde
// @icerir: Sistem kapatılıyor...
// @denetle: e2fsck -fn tests/_cikti/disk09/uppix-kok.img
// @denetle: debugfs -R 'cat /root/vy.txt' tests/_cikti/disk09/uppix-kok.img 2>/dev/null | grep -q 'veri yolu yazdı'

kullan "../../kaynak/uppix.upp";

fonk ana() -> sayi {
    uppix_baslat();
    don 0;
}
