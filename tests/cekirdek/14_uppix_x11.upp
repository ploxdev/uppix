// @bekle: ayarlar: tema Orman
// @girdi: cat /etc/X11/klavye /etc/jwm/ayarlar
// @girdi: sleep 10; echo bekle""di_3
// @bekle: bekledi_3
// @girdi_kacis: \x01cscreendump /tmp/upp_x11_6.ppm
// @girdi_kacis: \x01c
// @girdi: oturum cikis
// @bekle: oturum: soruldu (cikis)
// @girdi_kacis: \x01csendkey ret
// @girdi_kacis: \x01c
// @bekle: startx: oturum bitti
// @girdi: startx /usr/bin/ush -c "jwm -exit && echo ikinci oturum: X yanıt verdi"; echo "ikinci startx kod=$?"
// @bekle: ikinci startx kod=
// @girdi: olaytest --kip
// @bekle: konsol: KDGETMODE
// @girdi: echo "metin kipi geri geldi"
// @bekle: metin kipi geri geldi
// @girdi_kacis: \x01cscreendump /tmp/upp_x11_3.ppm
// @girdi_kacis: \x01c
// @girdi: startx /usr/bin/oturum kapat
// @bekle: oturum: soruldu (kapat)
// @girdi_kacis: \x01csendkey ret
// @icerir: /usr/bin/startx
// @icerir: /dev/ptmx
// @icerir: startx: X hazır (:0)
// @icerir: jwm: masaüstü hazır
// @icerir: xdeneme: ekran 1280x800 derinlik 24
// @icerir: xdeneme: pencere eşlendi
// @icerir: xdeneme: tuş a
// @icerir: xdeneme: fare tuşu 1
// @icerir: xdeneme: bitti
// @icerir: uterm| pty-tamam
// @icerir: uterm| 0
// @icerir: uterm| /root
// @icerir: uterm: bitti
// @icerir: ayarlar: tema Orman, saat %H:%M:%S, klavye tr
// @icerir: oturum: cikis
// @icerir: startx: oturum bitti
// @icerir: ikinci oturum: X yanıt verdi
// @icerir: ikinci startx kod=0
// @icerir: konsol: KDGETMODE 0 KDGKBMODE 1
// @icerir: metin kipi geri geldi
// @icerir: oturum: kapat
// @icerir: Sistem kapatılıyor...
// @denetle: python3 -c "d=open('/tmp/upp_x11_1.ppm','rb').read(); p=d.split(b'\n',3); w=int(p[1].split()[0]); o=lambda x,y: tuple(p[3][(y*w+x)*3:(y*w+x)*3+3]); b=[(500,320,(220,0,0)),(585,375,(220,0,0)),(445,255,(0,160,0)),(835,545,(0,160,0)),(100,5,(16,27,46)),(1200,5,(16,27,46)),(900,787,(33,48,70))]; k=[(x,y,o(x,y),r) for x,y,r in b if o(x,y)!=r]; assert not k, k; a=o(100,770); assert a[2]>140 and a[2]>a[0], a; print('pencere, masaustu degradesi ve serit tamam')"
// @denetle: python3 -c "import collections; d=open('/tmp/upp_x11_4.ppm','rb').read(); q=d.split(b'\n',3)[3]; c=collections.Counter(q[i:i+3] for i in range(0,len(q),3)); n=lambda r: c[bytes(r)]; s=(n((20,26,34)),n((216,222,233)),n((165,224,117))); assert s[0]>100000 and s[1]>300 and s[2]>100, s; print('ucbirim tamam', s)"
// @denetle: python3 -c "import collections; d=open('/tmp/upp_x11_5.ppm','rb').read(); q=d.split(b'\n',3)[3]; c=collections.Counter(q[i:i+3] for i in range(0,len(q),3)); n=lambda r: c[bytes(r)]; s=n((243,245,248)); assert s>15000, s; print('menu tamam', s)"
// @denetle: python3 -c "d=open('/tmp/upp_x11_6.ppm','rb').read(); p=d.split(b'\n',3); w=int(p[1].split()[0]); o=lambda x,y: tuple(p[3][(y*w+x)*3:(y*w+x)*3+3]); b=[(100,5,(14,34,25)),(900,787,(33,56,44))]; k=[(x,y,o(x,y),r) for x,y,r in b if o(x,y)!=r]; assert not k, k; print('Orman temasi tamam')"
// @denetle: python3 -c "d=open('/tmp/upp_x11_3.ppm','rb').read(); q=d.split(b'\n',3)[3]; r=set(tuple(q[i:i+3]) for i in range(0,len(q),3)); assert not r & {(16,27,46),(14,34,25),(243,245,248),(20,26,34),(0,160,0),(220,0,0)}, r; assert len(r) > 1, r; print('metin kipi tamam')"
// @denetle: rm -f /tmp/upp_x11_*.ppm
// @denetle: dd if=tests/_cikti/x11_img/uppix.img of=/tmp/upp_x11_p2.img bs=1M skip=65 status=none && e2fsck -fn /tmp/upp_x11_p2.img && rm -f /tmp/upp_x11_p2.img

kullan "../../kaynak/uppix.upp";

fonk ana() -> sayi {
    uppix_baslat();
    don 0;
}
