// @girdi: mouse_move 20 10
// @girdi: mouse_button 1
// @girdi: mouse_button 0
// @bekle: xdeneme: bitti
// @girdi_kacis: \x01c
// @girdi: uterm --dokum &
// @bekle: uterm: hazır
// @girdi_kacis: \x01csendkey e
// @girdi: sendkey c
// @girdi: sendkey h
// @girdi: sendkey o
// @girdi: sendkey spc
