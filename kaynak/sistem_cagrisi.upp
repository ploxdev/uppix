// Uppix — Linux x86_64 uyumlu sistem çağrıları.
// Numaralar, bayraklar, errno değerleri ve yapı düzenleri (struct stat,
// winsize, timespec, termios, fb_var/fix_screeninfo) Linux'takiyle aynıdır:
// -nostdlib ile derlenmiş statik bir Linux programı Uppix'te değiştirilmeden
// çalışır. Hata dönüşü -errno'dur. Çekirdek bu işleyiciyi SYSCALL girişinden,
// sürecin kendi görevinde çağırır (bkz. upp_kullanici.c).

// errno
sabit sayi EPERM = 1;
sabit sayi ENOENT = 2;
sabit sayi ESRCH = 3;
sabit sayi EINTR = 4;
sabit sayi EIO = 5;
sabit sayi E2BIG = 7;
sabit sayi ENOEXEC = 8;
sabit sayi EBADF = 9;
sabit sayi ECHILD = 10;
sabit sayi EAGAIN = 11;
sabit sayi ENOMEM = 12;
sabit sayi EACCES = 13;
sabit sayi EFAULT = 14;
sabit sayi EBUSY = 16;
sabit sayi EEXIST = 17;
sabit sayi ENODEV = 19;
sabit sayi ENOTDIR = 20;
sabit sayi EISDIR = 21;
sabit sayi EINVAL = 22;
sabit sayi EMFILE = 24;
sabit sayi ENOTTY = 25;
sabit sayi ESPIPE = 29;
sabit sayi EROFS = 30;
sabit sayi EPIPE = 32;
sabit sayi ERANGE = 34;
sabit sayi ENAMETOOLONG = 36;
sabit sayi ENOSYS = 38;
sabit sayi ENOTEMPTY = 39;
sabit sayi ELOOP = 40;
sabit sayi EOPNOTSUPP = 95;
sabit sayi ETIMEDOUT = 110;

// open bayrakları
sabit sayi O_ERISIM = 3;      // O_RDONLY 0, O_WRONLY 1, O_RDWR 2
sabit sayi O_CREAT = 64;
sabit sayi O_EXCL = 128;
sabit sayi O_TRUNC = 512;
sabit sayi O_APPEND = 1024;
sabit sayi O_DIRECTORY = 65536;
sabit sayi AT_FDCWD = -100;

// mmap
sabit sayi MAP_SHARED = 1;
sabit sayi MAP_PRIVATE = 2;
sabit sayi MAP_FIXED = 16;
sabit sayi MAP_ANONYMOUS = 32;

// ioctl
sabit sayi TCGETS = 0x5401;
sabit sayi TIOCGWINSZ = 0x5413;
sabit sayi FBIOGET_VSCREENINFO = 0x4600;
sabit sayi FBIOGET_FSCREENINFO = 0x4602;

sabit sayi SIGINT = 2;
sabit sayi SIGKILL = 9;
sabit sayi SIGPIPE = 13;

harita[sayi, mantik] g_sc_bildirildi; // desteklenmeyen çağrı günlüğe bir kez yazılır

fonk sistem_cagrilari_kur() -> bos {
    eger (upp.cekirdek.kullanici_destekli()) {
        upp.cekirdek.sistem_cagrisi_kur(sistem_cagrisi);
        klog("kullanıcı kipi: ring 3, SYSCALL/SYSRET, Linux x86_64 sistem çağrıları");
    }
}

// Linux x86_64 numaraları. Kategoriler: G/Ç ve bellek bu dosyada, dosya sistemi
// ve tanımlayıcılar sistem_cagrisi_dosya.upp'ta, süreç/zaman/TLS
// sistem_cagrisi_surec.upp'tadır.
fonk sistem_cagrisi(sayi no, sayi a1, sayi a2, sayi a3, sayi a4, sayi a5, sayi a6) -> sayi {
    sayi s = surec_simdi();
    eger (s < 0) { don -ENOSYS; }
    // kabuğun görevindeki sürece başka bir süreç sinyal göndermiş: süreç burada biter
    eger (g_surec[s].bekleyen) { don sc_bekleyen_bitir(s); }
    eger (sc_alarm_denetle(s)) { don -EINTR; }
    // G/Ç
    eger (no == 0) { don sc_read(s, a1, a2, a3); }
    eger (no == 1) { don sc_write(s, a1, a2, a3); }
    eger (no == 17) { don sc_pread(s, a1, a2, a3, a4, yanlis); }
    eger (no == 18) { don sc_pread(s, a1, a2, a3, a4, dogru); }
    eger (no == 19) { don sc_vektor(s, a1, a2, a3, yanlis); }
    eger (no == 20) { don sc_vektor(s, a1, a2, a3, dogru); }
    eger (no == 8) { don sc_lseek(s, a1, a2, a3); }
    eger (no == 16) { don sc_ioctl(s, a1, a2, a3); }
    // tanımlayıcılar ve dosya sistemi
    eger (no == 2) { don sc_open(s, AT_FDCWD, a1, a2, a3); }
    eger (no == 257) { don sc_open(s, a1, a2, a3, a4); }
    eger (no == 3) { don sc_close(s, a1); }
    eger (no == 4 || no == 6) { don sc_stat(s, AT_FDCWD, a1, a2, 0); }
    eger (no == 5) { don sc_fstat(s, a1, a2); }
    eger (no == 262) { don sc_stat(s, a1, a2, a3, a4); }
    eger (no == 32) { don sc_dup(s, a1, -1, 0); }
    eger (no == 33) { don sc_dup(s, a1, a2, 0); }
    eger (no == 292) { don sc_dup(s, a1, a2, a3 + 1); }
    eger (no == 72) { don sc_fcntl(s, a1, a2, a3); }
    eger (no == 217) { don sc_getdents64(s, a1, a2, a3); }
    eger (no == 21) { don sc_access(s, AT_FDCWD, a1, a2); }
    eger (no == 269 || no == 439) { don sc_access(s, a1, a2, a3); }
    eger (no == 79) { don sc_getcwd(s, a1, a2); }
    eger (no == 80) { don sc_chdir(s, a1, -1); }
    eger (no == 81) { don sc_chdir(s, 0, a1); }
    eger (no == 83) { don sc_mkdir(s, AT_FDCWD, a1, a2); }
    eger (no == 258) { don sc_mkdir(s, a1, a2, a3); }
    eger (no == 84) { don sc_unlink(s, AT_FDCWD, a1, AT_REMOVEDIR); }
    eger (no == 87) { don sc_unlink(s, AT_FDCWD, a1, 0); }
    eger (no == 263) { don sc_unlink(s, a1, a2, a3); }
    eger (no == 82) { don sc_rename(s, AT_FDCWD, a1, AT_FDCWD, a2); }
    eger (no == 264 || no == 316) { don sc_rename(s, a1, a2, a3, a4); }
    eger (no == 89) { don sc_readlink(s, AT_FDCWD, a1, a2, a3); }
    eger (no == 267) { don sc_readlink(s, a1, a2, a3, a4); }
    eger (no == 22) { don sc_pipe2(s, a1, 0); }
    eger (no == 293) { don sc_pipe2(s, a1, a2); }
    // soketler (AF_UNIX)
    eger (no == 41) { don sc_socket(s, a1, a2, a3); }
    eger (no == 53) { don sc_socketpair(s, a1, a2, a3, a4); }
    eger (no == 49) { don sc_bind(s, a1, a2, a3 & 0xFFFFFFFF); }
    eger (no == 50) { don sc_listen(s, a1, a2); }
    eger (no == 43) { don sc_accept(s, a1, a2, a3, 0); }
    eger (no == 288) { don sc_accept(s, a1, a2, a3, a4); }
    eger (no == 42) { don sc_connect(s, a1, a2, a3 & 0xFFFFFFFF); }
    eger (no == 51) { don sc_getsockname(s, a1, a2, a3, yanlis); }
    eger (no == 52) { don sc_getsockname(s, a1, a2, a3, dogru); }
    eger (no == 48) { don sc_shutdown(s, a1, a2); }
    eger (no == 44) { don sc_sendto(s, a1, a2, a3, a4, a5, a6 & 0xFFFFFFFF); }
    eger (no == 45) { don sc_recvfrom(s, a1, a2, a3, a4, a5, a6); }
    eger (no == 46) { don sc_sendmsg(s, a1, a2, a3); }
    eger (no == 47) { don sc_recvmsg(s, a1, a2, a3); }
    eger (no == 54) { don sc_setsockopt(s, a1, a2, a3, a4, isaretli32(a5)); }
    eger (no == 55) { don sc_getsockopt(s, a1, a2, a3, a4, a5); }
    // hazırlık ve olay tanımlayıcıları
    eger (no == 7) { don sc_poll(s, a1, a2, bitis_ani(isaretli32(a3))); }
    eger (no == 271) { don sc_ppoll(s, a1, a2, a3, a4, a5); }
    eger (no == 23) { don sc_select_tv(s, isaretli32(a1), a2, a3, a4, a5); }
    eger (no == 270) { don sc_pselect6(s, isaretli32(a1), a2, a3, a4, a5); }
    eger (no == 213) {
        eger (isaretli32(a1) <= 0) { don -EINVAL; }
        don sc_epoll_create(s, 0);
    }
    eger (no == 291) { don sc_epoll_create(s, a1); }
    eger (no == 233) { don sc_epoll_ctl(s, a1, a2, a3, a4); }
    eger (no == 232 || no == 281) { don sc_epoll_wait(s, a1, a2, isaretli32(a3), bitis_ani(isaretli32(a4))); }
    eger (no == 290) { don sc_eventfd(s, a1, a2); }
    eger (no == 284) { don sc_eventfd(s, a1, 0); }
    eger (no == 283) { don sc_timerfd_create(s, a1, a2); }
    eger (no == 286) { don sc_timerfd_settime(s, a1, a2, a3, a4); }
    eger (no == 287) { don sc_timerfd_gettime(s, a1, a2); }
    eger (no == 38) { don sc_setitimer(s, a1, a2, a3); }
    eger (no == 36) { don sc_getitimer(s, a1, a2); }
    eger (no == 37) { don sc_alarm(s, a1); }
    eger (no == 34) { don sc_pause(s); }
    // bellek
    eger (no == 9) { don sc_mmap(s, a1, a2, a3, a4, a5, a6); }
    eger (no == 10) { don sc_mprotect(s, a1, a2, a3); }
    eger (no == 11) { don sc_munmap(s, a1, a2); }
    eger (no == 26) { don sc_msync(s, a1, a2, a3); }
    eger (no == 12) { don sc_brk(s, a1); }
    // süreç, zaman, TLS
    eger (no == 60 || no == 231) {
        // exit / exit_group (tek iş parçacıklı süreçte aynıdır)
        upp.cekirdek.kullanici_cikis_iste(a1 % 256);
        don 0;
    }
    eger (no == 57 || no == 58) { don sc_fork(s, 0, 0, 0, 0, 0); } // fork, vfork (fork gibi)
    eger (no == 56) { don sc_clone(s, a1, a2, a3, a4, a5); }
    eger (no == 59) { don sc_execve(s, a1, a2, a3); }
    eger (no == 61) { don sc_wait4(s, isaretli32(a1), a2, a3, a4); }
    eger (no == 247) { don sc_waitid(s, a1, isaretli32(a2), a3, a4, a5); }
    eger (no == 39 || no == 186) { don g_surec[s].pid; }      // getpid, gettid
    eger (no == 110) { don g_surec[s].ebeveyn; }              // getppid
    eger (no == 102 || no == 104 || no == 107 || no == 108) { don 0; } // root
    eger (no == 218) { don g_surec[s].pid; }                  // set_tid_address
    eger (no == 273) { don 0; }                               // set_robust_list
    eger (no == 158) { don sc_arch_prctl(s, a1, a2); }
    eger (no == 63) { don sc_uname(s, a1); }
    eger (no == 228) { don sc_clock_gettime(s, a1, a2, yanlis); }
    eger (no == 229) { don sc_clock_gettime(s, a1, a2, dogru); }
    eger (no == 96) { don sc_gettimeofday(s, a1); }
    eger (no == 201) { don sc_time(s, a1); }
    eger (no == 35) { don sc_nanosleep(s, a1, a2); }
    eger (no == 230) { don sc_clock_nanosleep(s, a1, a2, a3, a4); }
    eger (no == 24) {
        upp.cekirdek.sira_ver();                              // sched_yield
        don 0;
    }
    eger (no == 318) { don sc_getrandom(s, a1, a2, a3); }
    eger (no == 13) { don sc_rt_sigaction(s, a1, a2, a3, a4); }
    eger (no == 14) { don sc_rt_sigprocmask(s, a1, a2, a3, a4); }
    eger (no == 97) { don sc_prlimit(s, 0, a1, 0, a2); }
    eger (no == 302) { don sc_prlimit(s, a1, a2, a3, a4); }
    eger (no == 160) { don sc_prlimit(s, 0, a1, a2, 0); }     // setrlimit
    eger (no == 95) { don sc_umask(s, a1); }
    eger (no == 28) { don sc_madvise(s, a1, a2, a3); }
    eger (no == 131) { don sc_sigaltstack(s, a1, a2); }
    eger (no == 202) { don sc_futex(s, a1, a2, a3, a4); }
    eger (no == 62) { don sc_kill(s, isaretli32(a1), a2); }
    eger (no == 200) { don sc_tkill(s, isaretli32(a1), isaretli32(a1), a2); }
    eger (no == 234) { don sc_tkill(s, isaretli32(a1), isaretli32(a2), a3); }
    eger (no == 111) { don g_surec[s].pgid; }                 // getpgrp
    eger (no == 121 || no == 124) { don sc_getpgid(s, isaretli32(a1)); } // getpgid, getsid
    eger (no == 99) { don sc_sysinfo(s, a1); }
    eger (!g_sc_bildirildi.var_mi(no)) {
        g_sc_bildirildi.koy(no, dogru);
        klog_sessiz("sistem çağrısı desteklenmiyor: {no} (süreç {g_surec[s].pid} {g_surec[s].ad})");
    }
    don -ENOSYS;
}

// ---- yardımcılar ----

fonk sc_yol(sayi s, sayi adres) -> metin => upp.cekirdek.kullanici_metin(g_surec[s].ka, adres, 4096);

// *at çağrılarının yolu: mutlak yol olduğu gibi; göreli yol dirfd'nin dizinine
// (AT_FDCWD: sürecin çalışma dizini) bağlanır. Hatada yok döner, g_sc_hata -errno.
sabit sayi AT_EMPTY_PATH = 4096;
sabit sayi AT_REMOVEDIR = 512;
sayi g_sc_hata = 0;

fonk sc_yol_at(sayi s, sayi dirfd, sayi adres, mantik bos_olabilir) -> metin {
    metin yol = sc_yol(s, adres);
    eger (yol == yok) {
        g_sc_hata = -EFAULT;
        don yok;
    }
    eger (yol == "" && !bos_olabilir) {
        g_sc_hata = -ENOENT;
        don yok;
    }
    eger (bayt_say(yol) >= 4096) {
        g_sc_hata = -ENAMETOOLONG;
        don yok;
    }
    eger (upp.metin.baslar(yol, "/")) { don yol; }
    sayi taban = g_surec[s].cwd;
    eger (dirfd != AT_FDCWD) {
        eger (!fd_gecerli(s, dirfd)) {
            g_sc_hata = -EBADF;
            don yok;
        }
        sayi y = fd_yer(s, dirfd);
        eger (g_fd_tur[y] != FD_DIZIN) {
            g_sc_hata = -ENOTDIR;
            don yok;
        }
        taban = g_fd_no[y];
    }
    eger (yol == "") { don fs_yol(taban); }
    don yol_birlestir(fs_yol(taban), yol);
}

// Kullanıcı belleğinden n bayt metin (bayt korunur); hatalı adreste yok.
fonk sc_oku_metin(sayi s, sayi adres, sayi n) -> metin {
    eger (n == 0) { don ""; }
    sayi t = upp.tampon.yeni(n);
    metin m = yok;
    eger (upp.cekirdek.kullanici_oku(g_surec[s].ka, adres, t, 0, n)) { m = upp.tampon.metin(t, 0, n); }
    upp.tampon.birak(t);
    don m;
}

// Metnin bayt aralığını kullanıcı belleğine yazar.
fonk sc_yaz_metin(sayi s, sayi adres, metin m, sayi bas, sayi n) -> mantik {
    eger (n <= 0) { don dogru; }
    sayi t = upp.tampon.yeni(bayt_say(m) + 1);
    upp.tampon.metin_yaz(t, 0, m);
    mantik ok = upp.cekirdek.kullanici_yaz(g_surec[s].ka, adres, t, bas, n);
    upp.tampon.birak(t);
    don ok;
}

// Kullanıcıya bir yapı yazar ve tamponu bırakır.
fonk sc_yapi_ver(sayi s, sayi adres, sayi t, sayi n) -> sayi {
    mantik ok = upp.cekirdek.kullanici_yaz(g_surec[s].ka, adres, t, 0, n);
    upp.tampon.birak(t);
    eger (!ok) { don -EFAULT; }
    don 0;
}

// Oluşturma kipi: izin bitleri, sürecin umask'ı düşülür.
fonk sc_kip(sayi s, sayi kip) -> sayi => (kip & 4095) - (kip & g_surec[s].umask & 4095);

fonk sc_on_planda(sayi s) -> mantik => g_surec[s].gorev == 1;

// int türündeki argüman (pid_t, int): üst 32 bit çağırana göre çöp olabilir.
fonk isaretli32(sayi v) -> sayi {
    sayi x = v & 0xFFFFFFFF;
    eger (x >= 0x80000000) { don x - 0x100000000; }
    don x;
}

// Ön plandaki süreç Ctrl-C ile SIGINT alır (çıkış 130); grubundaki süreçler de
// (fork'un çocukları) sonlanır.
fonk sc_kesme(sayi s) -> sayi {
    her (sayi i in 0..g_surec.uzunluk()) {
        eger (i != s && g_surec[i].pid != 0 && !g_surec[i].zombi && g_surec[i].pgid == g_surec[s].pgid) { sinyal_gonder(s, i, SIGINT); }
    }
    g_surec[s].sinyal = SIGINT;
    upp.cekirdek.kullanici_cikis_iste(130);
    terminale_yaz("^C\n");
    don -EINTR;
}

// Bekleyen sinyal: süreç sistem çağrısı dönerken 128 + sinyal ile biter.
fonk sc_bekleyen_bitir(sayi s) -> sayi {
    g_surec[s].bekleyen = yanlis;
    upp.cekirdek.kullanici_cikis_iste(128 + g_surec[s].sinyal);
    don -EINTR;
}

// Engelleyen çağrıların (wait4, boru) bir bekleme adımı: diğer görevlere sıra verir.
// Dönüş 0: beklemeye devam; < 0: Ctrl-C ya da bekleyen sinyalle kesildi.
fonk sc_bekle(sayi s) -> sayi {
    upp.uyut(1);
    eger (g_surec[s].bekleyen) { don sc_bekleyen_bitir(s); }
    eger (sc_alarm_denetle(s)) { don -EINTR; }
    eger (sc_on_planda(s) && kesme_istendi_mi()) { don sc_kesme(s); }
    don 0;
}

// ---- read ----

// Terminalden kanonik satır: yankı, geri silme, Ctrl-D (boş satırda EOF), Ctrl-C. Satır
// düzeni (tty_tus_isle) poll ile ortaktır: poll'un işlediği yarım satır burada sürer.
// Dönüş: 1 satır hazır, 0 EOF, -1 Ctrl-C.
fonk sc_terminal_satir(sayi s) -> sayi {
    iken (g_surec[s].satir_artik == "" && !g_surec[s].satir_eof) {
        eger (tty_tus_isle(s, tus_al()) < 0) { don -1; }
    }
    eger (g_surec[s].satir_artik == "") {
        g_surec[s].satir_eof = yanlis;
        don 0;
    }
    don 1;
}

fonk sc_read(sayi s, sayi fd, sayi buf, sayi n) -> sayi {
    eger (!fd_gecerli(s, fd)) { don -EBADF; }
    eger (n < 0) { don -EINVAL; }
    eger (n == 0) { don 0; }
    sayi y = fd_yer(s, fd);
    sayi tur = g_fd_tur[y];
    eger (tur == FD_NULL) { don 0; }
    eger (tur == FD_DIZIN) { don -EISDIR; }
    eger (tur == FD_FB) { don -EINVAL; }
    eger (g_fd_bayrak[y] % 4 == 1) { don -EBADF; }
    eger (tur == FD_BORU_OKU) { don boru_oku(s, y, buf, n); }
    eger (tur == FD_OLAY) { don sc_olay_oku(s, y, buf, n); }
    eger (tur == FD_SOKET) { don sc_soket_oku(s, y, fd, buf, n); }
    eger (tur == FD_EVENTFD) { don sayac_oku(s, y, buf, n); }
    eger (tur == FD_TIMERFD) { don zamanlayici_oku(s, y, buf, n); }
    eger (tur == FD_EPOLL) { don -EINVAL; }
    eger (tur == FD_TERMINAL && g_kb_kip != K_XLATE && g_kb_kip != K_UNICODE) { don sc_tty_ham_oku(s, y, buf, n); }
    eger (tur == FD_TERMINAL) {
        eger (g_surec[s].satir_artik == "") {
            sayi r = sc_terminal_satir(s);
            eger (r < 0) { don sc_kesme(s); }
            eger (r == 0) { don 0; }
        }
        metin artik = g_surec[s].satir_artik;
        sayi var = bayt_say(artik);
        sayi k = n;
        eger (k > var) { k = var; }
        eger (!sc_yaz_metin(s, buf, artik, 0, k)) { don -EFAULT; }
        eger (k == var) {
            g_surec[s].satir_artik = "";
        } yoksa {
            sayi t = upp.tampon.yeni(var);
            upp.tampon.metin_yaz(t, 0, artik);
            g_surec[s].satir_artik = upp.tampon.metin(t, k, var - k);
            upp.tampon.birak(t);
        }
        don k;
    }
    // Kabuktan girdi ya da dosya: içeriğin konumdan itibaren baytları
    metin icerik = "";
    sayi konum = 0;
    eger (tur == FD_GIRDI) {
        icerik = g_surec[s].girdi;
        konum = g_surec[s].girdi_konum;
    } yoksa {
        icerik = fs_oku(g_fd_no[y]);
        konum = g_fd_konum[y];
    }
    sayi toplam = bayt_say(icerik);
    eger (konum >= toplam) { don 0; }
    sayi k = n;
    eger (k > toplam - konum) { k = toplam - konum; }
    eger (!sc_yaz_metin(s, buf, icerik, konum, k)) { don -EFAULT; }
    eger (tur == FD_GIRDI) { g_surec[s].girdi_konum = konum + k; } yoksa { g_fd_konum.yaz(y, konum + k); }
    don k;
}

// ---- write ----

fonk sc_write(sayi s, sayi fd, sayi buf, sayi n) -> sayi {
    eger (!fd_gecerli(s, fd)) { don -EBADF; }
    eger (n < 0) { don -EINVAL; }
    sayi y = fd_yer(s, fd);
    sayi tur = g_fd_tur[y];
    eger (tur == FD_DIZIN) { don -EISDIR; }
    eger (tur == FD_FB) { don -EINVAL; }
    eger (tur == FD_GIRDI || g_fd_bayrak[y] % 4 == 0) { don -EBADF; }
    eger (n == 0) { don 0; }
    eger (tur == FD_NULL) { don n; }
    eger (tur == FD_BORU_YAZ) { don boru_yaz(s, y, buf, n); }
    eger (tur == FD_OLAY) { don sc_olay_yaz(s, y, buf, n); }
    eger (tur == FD_SOKET) { don sc_soket_yaz(s, y, fd, buf, n); }
    eger (tur == FD_EVENTFD) { don sayac_yaz(s, y, buf, n); }
    eger (tur == FD_TIMERFD || tur == FD_EPOLL) { don -EINVAL; }
    metin veri = sc_oku_metin(s, buf, n);
    eger (veri == yok) { don -EFAULT; }
    eger (tur == FD_TERMINAL) {
        // stdout boruya/yönlendirmeye yakalanır; stderr doğrudan terminale gider
        eger (fd == 2 || g_fd_no[y] == -2) {
            eger (!g_hata_sustur) { terminale_yaz(veri); }
        } yoksa {
            yaz(veri);
        }
        don n;
    }
    sayi no = g_fd_no[y];
    sayi konum = g_fd_konum[y];
    sayi mevcut = fs_boyut(no);
    eger ((g_fd_bayrak[y] & O_APPEND) != 0) { konum = mevcut; }
    mantik ok = yanlis;
    eger (konum == mevcut) {
        ok = fs_yaz(no, veri, dogru);
    } yoksa {
        // Ortaya yazma: gerekirse sıfırlarla doldurup aralığı günceller.
        ok = fs_yaz_aralik(no, konum, veri);
    }
    eger (!ok) {
        eger (fs_salt_okunur(no)) { don -EROFS; }
        don -EIO;
    }
    g_fd_konum.yaz(y, konum + n);
    don n;
}

// ---- open / close ----

fonk sc_open(sayi s, sayi dirfd, sayi yol_adr, sayi bayrak, sayi kip) -> sayi {
    metin yol = sc_yol_at(s, dirfd, yol_adr, yanlis);
    eger (yol == yok) { don g_sc_hata; }
    sayi erisim = bayrak % 4;
    eger (erisim == 3) { don -EINVAL; }
    sayi no = fs_coz(yol);
    eger (no < 0) {
        eger ((bayrak & O_CREAT) == 0) { don -ENOENT; }
        sayi ust = fs_coz(yol_dizin(yol));
        eger (ust < 0) { don -ENOENT; }
        eger (!fs_dizin_mi(ust)) { don -ENOTDIR; }
        metin ad = yol_ad(yol);
        eger (bayt_say(ad) > 255) { don -ENAMETOOLONG; }
        no = fs_yeni(ust, ad, D_DOSYA, sc_kip(s, kip));
        eger (no < 0) {
            eger (fs_salt_okunur(ust)) { don -EROFS; }
            don -EACCES;
        }
    } yoksa {
        eger ((bayrak & O_CREAT) != 0 && (bayrak & O_EXCL) != 0) { don -EEXIST; }
    }
    sayi tur = FD_DOSYA;
    sayi dt = g_fs[no].tur;
    eger (dt == D_DIZIN) {
        eger (erisim != 0) { don -EISDIR; }
        tur = FD_DIZIN;
    } yoksa eger ((bayrak & O_DIRECTORY) != 0) {
        don -ENOTDIR;
    } yoksa eger (dt == D_AYGIT) {
        metin a = g_fs[no].aygit;
        eger (a == "null") { tur = FD_NULL; }
        yoksa eger (a == "konsol") { tur = FD_TERMINAL; }
        yoksa eger (a == "fb") { tur = FD_FB; }
        yoksa eger (olay_aygiti(a) >= 0) { tur = FD_OLAY; }
        yoksa eger (a == "soket") { don -ENXIO; }
        yoksa eger (a != "rastgele") { don -EACCES; }
    } yoksa {
        eger (erisim != 0 && (dt == D_SANAL || fs_salt_okunur(no))) {
            eger (fs_salt_okunur(no)) { don -EROFS; }
            don -EACCES;
        }
        eger (erisim != 0 && (bayrak & O_TRUNC) != 0) { fs_yaz(no, "", yanlis); }
    }
    sayi fd = fd_ayir(s);
    eger (fd < 0) { don -EMFILE; }
    // girdi aygıtının her açılışı yeni bir istemcidir (kendi olay kuyruğu)
    eger (tur == FD_OLAY) { no = girdi_istemci_yeni(olay_aygiti(g_fs[no].aygit)); }
    fd_kur(s, fd, tur, no, bayrak);
    eger (tur == FD_TERMINAL) { g_fd_no.yaz(fd_yer(s, fd), -2); }
    don fd;
}

fonk sc_close(sayi s, sayi fd) -> sayi {
    eger (!fd_gecerli(s, fd)) { don -EBADF; }
    fd_kur(s, fd, FD_KAPALI, -1, 0);
    don 0;
}

// ---- stat / fstat ----

// struct stat (x86_64, 144 bayt) tamponu.
fonk sc_stat_tampon(sayi mod, sayi ino, sayi aygit, sayi nlink, sayi uzunluk, sayi zaman) -> sayi {
    sayi t = upp.tampon.yeni(144);
    upp.tampon.doldur(t, 0, 144, 0);
    upp.tampon.yaz64(t, 0, aygit);      // st_dev
    upp.tampon.yaz64(t, 8, ino);        // st_ino
    upp.tampon.yaz64(t, 16, nlink);     // st_nlink
    upp.tampon.yaz32(t, 24, mod);       // st_mode
    upp.tampon.yaz32(t, 28, 0);         // st_uid
    upp.tampon.yaz32(t, 32, 0);         // st_gid
    upp.tampon.yaz64(t, 48, uzunluk);   // st_size
    upp.tampon.yaz64(t, 56, 4096);      // st_blksize
    upp.tampon.yaz64(t, 64, (uzunluk + 511) / 512); // st_blocks
    upp.tampon.yaz64(t, 72, zaman);     // st_atime
    upp.tampon.yaz64(t, 88, zaman);     // st_mtime
    upp.tampon.yaz64(t, 104, zaman);    // st_ctime
    don t;
}

fonk sc_dugum_stat(sayi no) -> sayi {
    sayi dt = g_fs[no].tur;
    sayi mod = 32768;                         // S_IFREG
    sayi nlink = 1;
    eger (dt == D_DIZIN) {
        mod = 16384;                          // S_IFDIR
        nlink = 2;
    }
    eger (dt == D_AYGIT) { mod = 8192; }      // S_IFCHR
    eger (dt == D_AYGIT && g_fs[no].aygit == "soket") { mod = 49152; } // S_IFSOCK
    mod += g_fs[no].kip % 4096;
    sayi ino = g_fs[no].ino;
    eger (ino <= 0) { ino = no + 1; }
    sayi uzunluk = 0;
    eger (dt == D_DOSYA || dt == D_DIZIN) { uzunluk = fs_boyut(no); }
    sayi t = sc_stat_tampon(mod, ino, g_fs[no].bag + 1, nlink, uzunluk, g_fs[no].zaman);
    eger (dt == D_AYGIT && g_fs[no].aygit != "soket") { upp.tampon.yaz64(t, 40, aygit_rdev(no)); }   // st_rdev
    don t;
}

fonk sc_stat(sayi s, sayi dirfd, sayi yol_adr, sayi buf, sayi bayrak) -> sayi {
    mantik bos_yol = (bayrak & AT_EMPTY_PATH) != 0;
    metin ham = sc_yol(s, yol_adr);
    eger (ham == yok) { don -EFAULT; }
    eger (ham == "" && bos_yol) {
        eger (dirfd == AT_FDCWD) { don sc_yapi_ver(s, buf, sc_dugum_stat(g_surec[s].cwd), 144); }
        don sc_fstat(s, dirfd, buf);
    }
    metin yol = sc_yol_at(s, dirfd, yol_adr, yanlis);
    eger (yol == yok) { don g_sc_hata; }
    sayi no = fs_coz(yol);
    eger (no < 0) { don -ENOENT; }
    don sc_yapi_ver(s, buf, sc_dugum_stat(no), 144);
}

fonk sc_fstat(sayi s, sayi fd, sayi buf) -> sayi {
    eger (!fd_gecerli(s, fd)) { don -EBADF; }
    sayi y = fd_yer(s, fd);
    sayi tur = g_fd_tur[y];
    eger (tur == FD_DOSYA || tur == FD_DIZIN || tur == FD_NULL || tur == FD_FB) {
        eger (g_fd_no[y] >= 0) { don sc_yapi_ver(s, buf, sc_dugum_stat(g_fd_no[y]), 144); }
    }
    eger (tur == FD_SOKET) {
        // soket: S_IFSOCK | 0777
        don sc_yapi_ver(s, buf, sc_stat_tampon(49152 + 511, g_fd_no[y] + 1, 8, 1, 0, simdi()), 144);
    }
    eger (tur == FD_EPOLL || tur == FD_EVENTFD || tur == FD_TIMERFD) {
        // anonim düğüm: tür biti yok, 0600
        don sc_yapi_ver(s, buf, sc_stat_tampon(384, 1, 9, 1, 0, simdi()), 144);
    }
    eger (tur == FD_OLAY) {
        // girdi aygıtı: S_IFCHR | 0660, 13:64 + n (mice 13:63)
        sayi ag = g_girdi[g_fd_no[y]].aygit;
        sayi t = sc_stat_tampon(8192 + 432, 1, 1, 1, 0, simdi());
        sayi kucuk = 64 + ag;
        eger (ag == OLAY_MICE) { kucuk = 63; }
        upp.tampon.yaz64(t, 40, 13 * 256 + kucuk);
        don sc_yapi_ver(s, buf, t, 144);
    }
    eger (tur == FD_GIRDI || fd_boru_mu(tur)) {
        // boru: S_IFIFO | 0600
        don sc_yapi_ver(s, buf, sc_stat_tampon(4096 + 384, 1, 1, 1, 0, simdi()), 144);
    }
    // terminal: S_IFCHR | 0620
    don sc_yapi_ver(s, buf, sc_stat_tampon(8192 + 400, 1, 1, 1, 0, simdi()), 144);
}

// ---- lseek ----

fonk sc_lseek(sayi s, sayi fd, sayi ofs, sayi nereden) -> sayi {
    eger (!fd_gecerli(s, fd)) { don -EBADF; }
    sayi y = fd_yer(s, fd);
    sayi tur = g_fd_tur[y];
    eger (tur == FD_TERMINAL || tur == FD_GIRDI || tur == FD_OLAY || fd_boru_mu(tur) || fd_anonim_mi(tur)) { don -ESPIPE; }
    eger (tur == FD_NULL || tur == FD_FB) { don 0; }
    sayi yeni = 0;
    eger (nereden == 0) {
        yeni = ofs;
    } yoksa eger (nereden == 1) {
        yeni = g_fd_konum[y] + ofs;
    } yoksa eger (nereden == 2) {
        yeni = fs_boyut(g_fd_no[y]) + ofs;
    } yoksa {
        don -EINVAL;
    }
    eger (yeni < 0) { don -EINVAL; }
    g_fd_konum.yaz(y, yeni);
    don yeni;
}

// ---- mmap / munmap / msync / brk ----

sabit sayi MS_ASYNC = 1;
sabit sayi MS_INVALIDATE = 2;
sabit sayi MS_SYNC = 4;

// Dosya destekli MAP_SHARED eşlemeleri. Bu eşlemelere yapılan yazmalar dosyaya
// yansımalıdır; sayfalar dosyadan kopyalandığı için geri yazmayı msync, munmap
// ve süreç sonu tetikler. (MAP_PRIVATE'te değişiklikler sürece özeldir.)
liste[sayi] g_esl_s;      // g_surec yuvası; -1 = boş girdi
liste[sayi] g_esl_adres;
liste[sayi] g_esl_boy;
liste[sayi] g_esl_no;     // VFS düğümü
liste[sayi] g_esl_ofs;    // eşlemenin dosyadaki başlangıcı

fonk esl_ekle(sayi s, sayi adres, sayi boy, sayi no, sayi ofs) -> bos {
    her (sayi i in 0..g_esl_s.uzunluk()) {
        eger (g_esl_s[i] < 0) {
            g_esl_s.yaz(i, s);
            g_esl_adres.yaz(i, adres);
            g_esl_boy.yaz(i, boy);
            g_esl_no.yaz(i, no);
            g_esl_ofs.yaz(i, ofs);
            don;
        }
    }
    g_esl_s.ekle(s);
    g_esl_adres.ekle(adres);
    g_esl_boy.ekle(boy);
    g_esl_no.ekle(no);
    g_esl_ofs.ekle(ofs);
}

// Eşlemenin [bas, son) ile kesişen bölümünü dosyaya geri yazar.
fonk esl_geri_yaz(sayi i, sayi bas, sayi son) -> bos {
    sayi a = g_esl_adres[i];
    sayi b = a + g_esl_boy[i];
    eger (bas > a) { a = bas; }
    eger (son < b) { b = son; }
    eger (b <= a) { don; }
    sayi dosya_ofs = g_esl_ofs[i] + (a - g_esl_adres[i]);
    sayi dosya_son = fs_boyut(g_esl_no[i]);
    // Eşleme dosyadan büyük olabilir; EOF ötesini yazmak dosyayı şişirirdi.
    eger (dosya_ofs >= dosya_son) { don; }
    sayi k = b - a;
    eger (dosya_ofs + k > dosya_son) { k = dosya_son - dosya_ofs; }
    metin veri = sc_oku_metin(g_esl_s[i], a, k);
    eger (veri == yok) { don; }
    fs_yaz_aralik(g_esl_no[i], dosya_ofs, veri);
}

// s sürecinin [bas, son) ile kesişen paylaşımlı eşlemelerini geri yazar; kaldir
// doğruysa kayıtları da kırpar/siler. Kesişen eşleme sayısını döndürür.
fonk esl_bosalt(sayi s, sayi bas, sayi son, mantik kaldir) -> sayi {
    sayi bulundu = 0;
    her (sayi i in 0..g_esl_s.uzunluk()) {
        eger (g_esl_s[i] != s) { devam; }
        sayi a = g_esl_adres[i];
        sayi b = a + g_esl_boy[i];
        eger (b <= bas || a >= son) { devam; }
        bulundu += 1;
        esl_geri_yaz(i, bas, son);
        eger (kaldir) {
            eger (bas <= a && son >= b) {
                g_esl_s.yaz(i, -1);
            } yoksa eger (bas <= a) {
                g_esl_ofs.yaz(i, g_esl_ofs[i] + (son - a));
                g_esl_adres.yaz(i, son);
                g_esl_boy.yaz(i, b - son);
            } yoksa {
                // sondan ya da ortadan kaldırma: baştaki kısım izlenmeye devam
                // eder, kalan kuyruk için geri yazma bırakılır (yanlış belleği
                // okumaktansa yazmamak yeğdir)
                g_esl_boy.yaz(i, bas - a);
            }
        }
    }
    don bulundu;
}

// fork: ebeveynin paylaşımlı eşleme kayıtları çocuğa da kopyalanır. Sayfalar çocukta
// özel kopyadır; her iki süreç de kendi yazdığını msync/munmap/çıkışta geri yazar.
fonk esl_kopyala(sayi s, sayi c) -> bos {
    sayi n = g_esl_s.uzunluk();
    her (sayi i in 0..n) {
        eger (g_esl_s[i] == s) { esl_ekle(c, g_esl_adres[i], g_esl_boy[i], g_esl_no[i], g_esl_ofs[i]); }
    }
}

// Süreç yuvası boşalırken çağrılır. yaz: adres alanı hâlâ geçerli mi (görev
// öldürüldüyse çekirdek alanı zaten sildiği için okunamaz).
fonk esl_surec_bitti(sayi s, mantik yaz) -> bos {
    her (sayi i in 0..g_esl_s.uzunluk()) {
        eger (g_esl_s[i] != s) { devam; }
        eger (yaz) { esl_geri_yaz(i, g_esl_adres[i], g_esl_adres[i] + g_esl_boy[i]); }
        g_esl_s.yaz(i, -1);
    }
}

// mmap için boş bir bölge: üst sınırdan aşağı doğru.
fonk sc_mmap_yer(sayi s, sayi uzunluk) -> sayi {
    sayi ka = g_surec[s].ka;
    sayi aday = sayfa_asagi(g_surec[s].mmap_ust - uzunluk);
    iken (aday > g_surec[s].brk + 16777216) {
        eger (upp.cekirdek.kullanici_bos_mu(ka, aday, uzunluk)) {
            g_surec[s].mmap_ust = aday;
            don aday;
        }
        aday -= SAYFA;
    }
    don -1;
}

fonk sc_mmap(sayi s, sayi adres, sayi uzunluk, sayi koruma, sayi bayrak, sayi fd, sayi ofs) -> sayi {
    sayi ka = g_surec[s].ka;
    // Denetim sırası Linux'taki gibi: ofset hizası, tanımlayıcı, uzunluk, eşleme türü.
    eger (ofs < 0 || ofs % SAYFA != 0) { don -EINVAL; }
    mantik anonim = (bayrak & MAP_ANONYMOUS) != 0;
    mantik sabit_yer = (bayrak & MAP_FIXED) != 0;
    sayi fd_tur = FD_KAPALI;
    sayi y = 0;
    eger (!anonim) {
        eger (!fd_gecerli(s, fd)) { don -EBADF; }
        y = fd_yer(s, fd);
        fd_tur = g_fd_tur[y];
    }
    eger (uzunluk <= 0) { don -EINVAL; }
    sayi paylasim = bayrak % 4;
    eger (paylasim != MAP_SHARED && paylasim != MAP_PRIVATE) { don -EINVAL; }
    eger (!anonim) {
        eger (fd_tur != FD_DOSYA && fd_tur != FD_FB) { don -ENODEV; }
        eger (g_fd_bayrak[y] % 4 == 1) { don -EACCES; }
    }
    sayi n = sayfa_yukari(uzunluk);
    // yerleşim
    sayi a = -1;
    eger (sabit_yer) {
        eger (adres % SAYFA != 0 || adres < 0x10000 || adres + n > YIGIN_UST) { don -EINVAL; }
        esl_bosalt(s, adres, adres + n, dogru);
        upp.cekirdek.kullanici_esleme_kaldir(ka, adres, n);
        a = adres;
    } yoksa eger (adres >= 0x10000 && adres % SAYFA == 0 && adres + n <= MMAP_UST && upp.cekirdek.kullanici_bos_mu(ka, adres, n)) {
        a = adres;
    } yoksa {
        a = sc_mmap_yer(s, n);
    }
    eger (a < 0) { don -ENOMEM; }
    // çerçeve tamponu: aygıt belleği doğrudan (önbelleksiz) eşlenir
    eger (fd_tur == FD_FB) {
        sayi fb_boy = upp.cekirdek.ekran_bilgi(1);
        eger (paylasim != MAP_SHARED || ofs + n > sayfa_yukari(fb_boy)) { don -EINVAL; }
        mantik ok = yanlis;
        guvensiz {
            ok = upp.cekirdek.kullanici_fiziksel_esle(ka, a, upp.cekirdek.ekran_bilgi(0) + ofs, n, koruma);
        }
        eger (!ok) { don -ENOMEM; }
        don a;
    }
    // anonim ya da dosya: sıfırlanmış sayfalar (dosya içeriği kopyalanır)
    sayi ilk = koruma;
    eger (!anonim) { ilk = 3; }
    eger (!upp.cekirdek.kullanici_esle(ka, a, n, ilk)) {
        upp.cekirdek.kullanici_esleme_kaldir(ka, a, n);
        don -ENOMEM;
    }
    eger (!anonim) {
        metin icerik = fs_oku_aralik(g_fd_no[y], ofs, n);
        sayi k = bayt_say(icerik);
        eger (k > 0) { sc_yaz_metin(s, a, icerik, 0, k); }
        upp.cekirdek.kullanici_koruma(ka, a, n, koruma, yanlis);
        // MAP_SHARED: yazmalar dosyaya yansımalı; geri yazabilmek için izlenir
        eger (paylasim == MAP_SHARED && g_fd_bayrak[y] % 4 != 0) {
            esl_ekle(s, a, n, g_fd_no[y], ofs);
        }
    }
    don a;
}

fonk sc_munmap(sayi s, sayi adres, sayi uzunluk) -> sayi {
    eger (adres % SAYFA != 0 || uzunluk <= 0 || adres < 0 || adres + uzunluk > YIGIN_UST) { don -EINVAL; }
    eger (adres < 0x10000) { don 0; }
    sayi n = sayfa_yukari(uzunluk);
    esl_bosalt(s, adres, adres + n, dogru);
    upp.cekirdek.kullanici_esleme_kaldir(g_surec[s].ka, adres, n);
    don 0;
}

fonk sc_msync(sayi s, sayi adres, sayi uzunluk, sayi bayrak) -> sayi {
    eger (adres % SAYFA != 0 || uzunluk < 0) { don -EINVAL; }
    eger ((bayrak & MS_ASYNC) != 0 && (bayrak & MS_SYNC) != 0) { don -EINVAL; }
    eger ((bayrak & (MS_ASYNC + MS_INVALIDATE + MS_SYNC)) != bayrak) { don -EINVAL; }
    eger (uzunluk == 0) { don 0; }
    sayi n = sayfa_yukari(uzunluk);
    eger (adres < 0 || adres + n > YIGIN_UST) { don -ENOMEM; }
    eger (esl_bosalt(s, adres, adres + n, yanlis) > 0) { don 0; }
    // paylaşımlı dosya eşlemesi yok: eşlenmemiş aralık hata, gerisi (anonim ya
    // da MAP_PRIVATE) Linux'taki gibi sessizce başarılı.
    eger (upp.cekirdek.kullanici_bos_mu(g_surec[s].ka, adres, n)) { don -ENOMEM; }
    don 0;
}

// brk(0) şimdiki sınırı verir; büyütme/küçültme başarısızsa eski sınır döner.
fonk sc_brk(sayi s, sayi yeni) -> sayi {
    sayi eski = g_surec[s].brk;
    eger (yeni == 0 || yeni < g_surec[s].brk_bas) { don eski; }
    sayi ka = g_surec[s].ka;
    sayi eski_s = sayfa_yukari(eski);
    sayi yeni_s = sayfa_yukari(yeni);
    eger (yeni_s > eski_s) {
        eger (yeni_s + 16777216 > g_surec[s].mmap_ust) { don eski; }
        eger (!upp.cekirdek.kullanici_bos_mu(ka, eski_s, yeni_s - eski_s)) { don eski; }
        eger (!upp.cekirdek.kullanici_esle(ka, eski_s, yeni_s - eski_s, 3)) {
            upp.cekirdek.kullanici_esleme_kaldir(ka, eski_s, yeni_s - eski_s);
            don eski;
        }
    } yoksa eger (yeni_s < eski_s) {
        upp.cekirdek.kullanici_esleme_kaldir(ka, yeni_s, eski_s - yeni_s);
    }
    g_surec[s].brk = yeni;
    don yeni;
}

// ---- ioctl ----

fonk sc_ioctl(sayi s, sayi fd, sayi istek, sayi arg) -> sayi {
    eger (!fd_gecerli(s, fd)) { don -EBADF; }
    sayi tur = g_fd_tur[fd_yer(s, fd)];
    eger ((istek & 0xFFFFFFFF) == FIONREAD) { don sc_fionread(s, fd_yer(s, fd), arg); }
    eger (tur == FD_OLAY) { don sc_olay_ioctl(s, fd_yer(s, fd), istek, arg); }
    eger (tur == FD_TERMINAL) {
        sayi k = sc_konsol_ioctl(s, istek & 0xFFFFFFFF, arg);
        eger (k != IOCTL_YOK) { don k; }
        eger (istek == TIOCGWINSZ) {
            // struct winsize { ws_row, ws_col, ws_xpixel, ws_ypixel } (u16)
            sayi t = upp.tampon.yeni(8);
            upp.tampon.yaz16(t, 0, upp.cekirdek.ekran_bilgi(13));
            upp.tampon.yaz16(t, 2, upp.cekirdek.ekran_bilgi(12));
            upp.tampon.yaz16(t, 4, upp.cekirdek.ekran_bilgi(2));
            upp.tampon.yaz16(t, 6, upp.cekirdek.ekran_bilgi(3));
            don sc_yapi_ver(s, arg, t, 8);
        }
        eger (istek == TCGETS) {
            // struct termios (60 bayt): kanonik kip, yankı, ISIG; isatty() bunu kullanır
            sayi t = upp.tampon.yeni(60);
            upp.tampon.doldur(t, 0, 60, 0);
            upp.tampon.yaz32(t, 0, 0x500);     // c_iflag: ICRNL | IXON
            upp.tampon.yaz32(t, 4, 0x5);       // c_oflag: OPOST | ONLCR
            upp.tampon.yaz32(t, 8, 0xBF);      // c_cflag: B38400 | CS8 | CREAD
            upp.tampon.yaz32(t, 12, 0x8A3B);   // c_lflag: ISIG ICANON ECHO ECHOE ECHOK ECHOCTL ECHOKE IEXTEN
            upp.tampon.yaz8(t, 17, 3);         // VINTR = ^C
            upp.tampon.yaz8(t, 19, 127);       // VERASE
            upp.tampon.yaz8(t, 21, 4);         // VEOF = ^D
            upp.tampon.yaz8(t, 23, 1);         // VMIN
            don sc_yapi_ver(s, arg, t, 60);
        }
        don -ENOTTY;
    }
    eger (tur == FD_FB && istek == FBIOGET_VSCREENINFO) {
        // struct fb_var_screeninfo (160 bayt)
        sayi gen = upp.cekirdek.ekran_bilgi(2);
        sayi yuk = upp.cekirdek.ekran_bilgi(3);
        sayi t = upp.tampon.yeni(160);
        upp.tampon.doldur(t, 0, 160, 0);
        upp.tampon.yaz32(t, 0, gen);           // xres
        upp.tampon.yaz32(t, 4, yuk);           // yres
        upp.tampon.yaz32(t, 8, gen);           // xres_virtual
        upp.tampon.yaz32(t, 12, yuk);          // yres_virtual
        upp.tampon.yaz32(t, 24, upp.cekirdek.ekran_bilgi(5)); // bits_per_pixel
        upp.tampon.yaz32(t, 32, upp.cekirdek.ekran_bilgi(7)); // red.offset
        upp.tampon.yaz32(t, 36, upp.cekirdek.ekran_bilgi(6)); // red.length
        upp.tampon.yaz32(t, 44, upp.cekirdek.ekran_bilgi(9)); // green.offset
        upp.tampon.yaz32(t, 48, upp.cekirdek.ekran_bilgi(8)); // green.length
        upp.tampon.yaz32(t, 56, upp.cekirdek.ekran_bilgi(11)); // blue.offset
        upp.tampon.yaz32(t, 60, upp.cekirdek.ekran_bilgi(10)); // blue.length
        upp.tampon.yaz32(t, 88, 0xFFFFFFFF);  // height (mm): bilinmiyor
        upp.tampon.yaz32(t, 92, 0xFFFFFFFF);  // width (mm)
        don sc_yapi_ver(s, arg, t, 160);
    }
    eger (tur == FD_FB && istek == FBIOGET_FSCREENINFO) {
        // struct fb_fix_screeninfo (80 bayt)
        sayi t = upp.tampon.yeni(80);
        upp.tampon.doldur(t, 0, 80, 0);
        upp.tampon.metin_yaz(t, 0, "uppixfb");
        upp.tampon.yaz64(t, 16, upp.cekirdek.ekran_bilgi(0)); // smem_start
        upp.tampon.yaz32(t, 24, upp.cekirdek.ekran_bilgi(1)); // smem_len
        upp.tampon.yaz32(t, 28, 0);                           // type: FB_TYPE_PACKED_PIXELS
        upp.tampon.yaz32(t, 36, 2);                           // visual: FB_VISUAL_TRUECOLOR
        upp.tampon.yaz32(t, 48, upp.cekirdek.ekran_bilgi(4)); // line_length
        don sc_yapi_ver(s, arg, t, 80);
    }
    don -ENOTTY;
}

// FIONREAD: okunmayı bekleyen bayt sayısı.
fonk sc_fionread(sayi s, sayi y, sayi arg) -> sayi {
    sayi tur = g_fd_tur[y];
    sayi no = g_fd_no[y];
    sayi n = 0;
    eger (tur == FD_SOKET) {
        n = soket_okunabilir_bayt(no);
        eger (n < 0) { don n; }
    } yoksa eger (tur == FD_BORU_OKU) {
        n = g_boru[no].dolu;
    } yoksa eger (tur == FD_TERMINAL) {
        n = bayt_say(g_surec[s].satir_artik);
    } yoksa eger (tur == FD_GIRDI) {
        n = upp.max(bayt_say(g_surec[s].girdi) - g_surec[s].girdi_konum, 0);
    } yoksa eger (tur == FD_DOSYA) {
        n = upp.max(fs_boyut(no) - g_fd_konum[y], 0);
    } yoksa {
        don -ENOTTY;
    }
    don sc_int_ver(s, arg, n);
}

// ---- nanosleep ----

fonk sc_nanosleep(sayi s, sayi istek, sayi kalan) -> sayi {
    sayi t = upp.tampon.yeni(16);
    eger (!upp.cekirdek.kullanici_oku(g_surec[s].ka, istek, t, 0, 16)) {
        upp.tampon.birak(t);
        don -EFAULT;
    }
    sayi sn = upp.tampon.oku64(t, 0);
    sayi ns = upp.tampon.oku64(t, 8);
    upp.tampon.birak(t);
    eger (sn < 0 || ns < 0 || ns >= 1000000000) { don -EINVAL; }
    sayi bitis = upp.zaman() + sn * 1000 + (ns + 999999) / 1000000;
    iken (upp.zaman() < bitis) {
        sayi k = bitis - upp.zaman();
        eger (k > 20) { k = 20; }
        upp.uyut(k);
        eger (sc_alarm_denetle(s)) { don -EINTR; }
        eger (sc_on_planda(s) && kesme_istendi_mi()) {
            eger (kalan != 0) {
                sayi r = upp.tampon.yeni(16);
                sayi kms = bitis - upp.zaman();
                eger (kms < 0) { kms = 0; }
                upp.tampon.yaz64(r, 0, kms / 1000);
                upp.tampon.yaz64(r, 8, kms % 1000 * 1000000);
                sc_yapi_ver(s, kalan, r, 16);
            }
            don sc_kesme(s);
        }
    }
    don 0;
}
